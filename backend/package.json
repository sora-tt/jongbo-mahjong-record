{
  "name": "mahjong-record-app-backend",
  "type": "module",
  "exports": {
    ".": "./src/presentation/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/presentation/server.ts",
    "start": "tsx src/presentation/server.ts",
    "compile": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "postinstall": "pnpm compile",
    "typecheck": "tsc --noEmit",
    "lint": "eslint '**/*.{js,jsx,ts,tsx,mjs,cjs}'",
    "lint:fix": "eslint '**/*.{js,jsx,ts,tsx,mjs,cjs}' --fix",
    "test:contract": "tsx --test src/domain/league/rule.test.ts src/domain/user/statsKey.test.ts src/domain/shared/scoring.test.ts src/domain/shared/aggregation.test.ts src/application/services/sessionService.test.ts src/application/services/matchService.test.ts src/infrastructure/firestore/utils.test.ts src/presentation/app.test.ts src/presentation/session.test.ts test/contracts/data-contract.test.ts",
    "test:emulator": "USE_FIRESTORE_EMULATOR=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GOOGLE_CLOUD_PROJECT=jongbo-local tsx --test src/infrastructure/firestore/repositories/matchRepository.emulator.test.ts src/infrastructure/firestore/repositories/lifecycle.emulator.test.ts",
    "repair:stats": "tsx src/scripts/rebuildStats.ts",
    "repair:stats:emulator": "USE_FIRESTORE_EMULATOR=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GOOGLE_CLOUD_PROJECT=jongbo-local tsx src/scripts/rebuildStats.ts",
    "emulator": "NODE_NO_WARNINGS=1 firebase emulators:start --project jongbo-local",
    "dev:emulator": "USE_FIRESTORE_EMULATOR=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GOOGLE_CLOUD_PROJECT=jongbo-local tsx watch src/presentation/server.ts",
    "seed": "USE_FIRESTORE_EMULATOR=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GOOGLE_CLOUD_PROJECT=jongbo-local tsx src/scripts/seedFirestore.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.4",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.7.6",
    "firebase-admin": "^13.4.0",
    "hono": "^4.12.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.11.17",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "firebase-tools": "^14.22.0",
    "prettier": "^3.3.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.1"
  }
}
